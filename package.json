{
  "name": "sitexcell-ui-prototype",
  "version": "1.0.0",
  "description": "Front-end UI modernization prototype for SiteXcell.",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./src/css/input.css -o ./assets/css/style.css --minify",
    "watch:css": "tailwindcss -i ./src/css/input.css -o ./assets/css/style.css --watch",
    "prototype:laan": "node proposed_laan_form/server.mjs",
    "test:laan:live": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\tests\\laan-request\\support\\run-live-session.ps1 -ShowBrowser -SlowMo 500",
    "test:laan:live:refresh": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\tests\\laan-request\\support\\run-live-session.ps1 -RefreshSession -ShowBrowser -SlowMo 500",
    "test:laan:live:navigation": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\tests\\laan-request\\support\\run-live-session.ps1 -ShowBrowser -SlowMo 500 -TestFile laan-request-navigation.spec.js",
    "test:laan:live:wave2": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\tests\\laan-request\\support\\run-live-session.ps1 -ShowBrowser -SlowMo 300 -ConfigFile tests/laan-request/configs/playwright.wave2.config.js",
    "test:laan:live:variants": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\tests\\laan-request\\support\\run-live-session.ps1 -ShowBrowser -SlowMo 300 -ConfigFile tests/laan-request/configs/playwright.wave2.config.js -TestFile laan-request-activity-variants.wave2.spec.js",
    "test:laan:live:validation": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\tests\\laan-request\\support\\run-live-session.ps1 -ShowBrowser -SlowMo 300 -ConfigFile tests/laan-request/configs/playwright.wave2.config.js -TestFile laan-request-validation.wave2.spec.js",
    "test:laan:live:date-boundaries": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\tests\\laan-request\\support\\run-live-session.ps1 -ShowBrowser -SlowMo 300 -ConfigFile tests/laan-request/configs/playwright.wave2.config.js -TestFile laan-request-date-boundaries.wave2.spec.js",
    "test:laan:live:upload-recovery": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\tests\\laan-request\\support\\run-live-session.ps1 -ShowBrowser -SlowMo 300 -ConfigFile tests/laan-request/configs/playwright.wave2.config.js -TestFile laan-request-upload-recovery.wave2.spec.js",
    "test:laan:live:reload": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\tests\\laan-request\\support\\run-live-session.ps1 -ShowBrowser -SlowMo 300 -ConfigFile tests/laan-request/configs/playwright.wave2.config.js -TestFile laan-request-reload.wave2.spec.js",
    "test:laan:live:keyboard": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\tests\\laan-request\\support\\run-live-session.ps1 -ShowBrowser -SlowMo 150 -ConfigFile tests/laan-request/configs/playwright.wave2.config.js -TestFile laan-request-keyboard.wave2.spec.js",
    "test:laan:live:responsive": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\tests\\laan-request\\support\\run-live-session.ps1 -ShowBrowser -SlowMo 300 -ConfigFile tests/laan-request/configs/playwright.wave2.config.js -TestFile laan-request-responsive.wave2.spec.js",
    "test:laan:live:gates": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\tests\\laan-request\\support\\run-live-session.ps1 -ShowBrowser -SlowMo 300 -ConfigFile tests/laan-request/configs/playwright.wave2.config.js -TestFile laan-request-improvement-gates.wave2.spec.js",
    "test:access:unit": "node --test tests/access-requests/unit/*.test.js",
    "test:access:docs": "node tests/access-requests/support/validate-documentation.mjs",
    "test:access:ledger": "node tests/access-requests/support/generate-field-rule-ledger.mjs",
    "test:access:live": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\tests\\access-requests\\support\\run-live-session.ps1",
    "test:access:live:refresh": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\tests\\access-requests\\support\\run-live-session.ps1 -RefreshSession -ShowBrowser -SlowMo 500",
    "test:access:live:steps-1-8": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\tests\\access-requests\\support\\run-live-session.ps1 -ConfigFile tests/access-requests/configs/playwright.steps-1-8.config.js -ReportFile access-request-steps-1-8-results.json -SuiteLabel steps-1-8 -PlannedCaseCount 34",
    "test:access:live:steps-1-8:refresh": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\tests\\access-requests\\support\\run-live-session.ps1 -RefreshSession -ShowBrowser -SlowMo 500 -ConfigFile tests/access-requests/configs/playwright.steps-1-8.config.js -ReportFile access-request-steps-1-8-results.json -SuiteLabel steps-1-8 -PlannedCaseCount 34",
    "test:access:live:journeys": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\tests\\access-requests\\support\\run-live-session.ps1 -SuiteLabel journeys -PlannedCaseCount 3 -TestFile tests/access-requests/live/access-request/journeys",
    "test:access:live:functional": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\tests\\access-requests\\support\\run-live-session.ps1 -SuiteLabel functional -PlannedCaseCount 4 -Grep \"TC-AR-00[1-4]\"",
    "test:access:live:behaviors": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\tests\\access-requests\\support\\run-live-session.ps1 -SuiteLabel behaviors -PlannedCaseCount 24 -TestFile tests/access-requests/live/access-request/behaviors",
    "test:access:live:quality": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\tests\\access-requests\\support\\run-live-session.ps1 -SuiteLabel quality -PlannedCaseCount 7 -TestFile tests/access-requests/live/access-request/quality",
    "test:access:live:branches": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\tests\\access-requests\\support\\run-live-session.ps1 -ConfigFile tests/access-requests/configs/playwright.access-request.config.js -SuiteLabel branches -PlannedCaseCount 5 -TestFile tests/access-requests/live/access-request/behaviors/conditional-branches.spec.js",
    "test:access:live:uploads": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\tests\\access-requests\\support\\run-live-session.ps1 -ConfigFile tests/access-requests/configs/playwright.access-request.config.js -SuiteLabel uploads -PlannedCaseCount 6 -Grep \"TC-AR-U0[1-7]\"",
    "test:access:live:recovery": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\tests\\access-requests\\support\\run-live-session.ps1 -ConfigFile tests/access-requests/configs/playwright.access-request.config.js -SuiteLabel recovery -PlannedCaseCount 2 -Grep \"TC-AR-R0[1-4]\"",
    "test:access:live:documents": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\tests\\access-requests\\support\\run-live-session.ps1 -ConfigFile tests/access-requests/configs/playwright.access-request.config.js -SuiteLabel documents -PlannedCaseCount 1 -Grep \"TC-AR-D0[1-4]\"",
    "test:access:live:efficiency": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\tests\\access-requests\\support\\run-live-session.ps1 -ConfigFile tests/access-requests/configs/playwright.access-request.config.js -SuiteLabel efficiency -PlannedCaseCount 2 -Grep \"TC-AR-E\"",
    "test:access:live:accessibility": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\tests\\access-requests\\support\\run-live-session.ps1 -ConfigFile tests/access-requests/configs/playwright.access-request.config.js -SuiteLabel accessibility -PlannedCaseCount 5 -Grep \"TC-AR-A0[1-5]\"",
    "test:access:live:responsive": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\tests\\access-requests\\support\\run-live-session.ps1 -ConfigFile tests/access-requests/configs/playwright.access-request.config.js -SuiteLabel responsive -PlannedCaseCount 5 -Grep \"TC-AR-A0[1-5]\"",
    "test:access:capture:steps-1-8": "node tests/access-requests/support/capture-steps-1-8-field-map.mjs",
    "test:access:capture:steps-5-8": "node tests/access-requests/support/capture-steps-5-8-field-map.mjs",
    "session:setup": "node tests/laan-request/support/create-storage-state.mjs",
    "results:serve": "node tests/laan-request/support/results-server.mjs"
  },
  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@playwright/test": "1.62.1",
    "tailwindcss": "^4.3.3"
  }
}
